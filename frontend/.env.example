# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API Authentication
# IMPORTANT: Store this securely, never commit real keys to version control
FLUXION_API_KEY=your_api_key_here

# OpenTelemetry Configuration
# OTLP collector endpoint for trace export
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Service identification
NEXT_PUBLIC_OTEL_SERVICE_NAME=fluxion-frontend
NEXT_PUBLIC_APP_VERSION=0.1.0

# Environment identifier (development, staging, production)
NEXT_PUBLIC_ENV=development

# Sample rate for traces (0.0 to 1.0)
# 1.0 = 100% of traces, 0.1 = 10% of traces
# Default: 1.0 in development, 0.1 in production
NEXT_PUBLIC_OTEL_SAMPLE_RATE=1.0

# Enable debug logging for OpenTelemetry (true/false)
NEXT_PUBLIC_OTEL_DEBUG=false
