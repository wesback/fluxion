#!/bin/bash
#
# Fluxion APT Hook - Automatic Package Update Reporting
# 
# This script is executed by APT after package operations and reports
# package updates to the Fluxion API for centralized tracking.
#
# Installation:
#   sudo cp 99fluxion /etc/apt/apt.conf.d/99fluxion
#   sudo chmod +x /etc/apt/apt.conf.d/99fluxion
#
# Configuration via environment variables:
#   FLUXION_API_URL      - API endpoint (required)
#   FLUXION_API_KEY      - API authentication key (optional)
#   FLUXION_TIMEOUT      - HTTP request timeout in seconds (default: 5)
#   FLUXION_LOG_FILE     - Log file path (default: /var/log/fluxion-hook.log)
#   FLUXION_BATCH_MODE   - Send updates in batch (default: true)
#

set -euo pipefail

# Configuration with defaults
FLUXION_API_URL="${FLUXION_API_URL:-}"
FLUXION_API_KEY="${FLUXION_API_KEY:-}"
FLUXION_TIMEOUT="${FLUXION_TIMEOUT:-5}"
FLUXION_LOG_FILE="${FLUXION_LOG_FILE:-/var/log/fluxion-hook.log}"
FLUXION_BATCH_MODE="${FLUXION_BATCH_MODE:-true}"
FLUXION_DETECT_SECURITY="${FLUXION_DETECT_SECURITY:-true}"

# Exit early if API URL is not configured
if [[ -z "$FLUXION_API_URL" ]]; then
    exit 0
fi

# Function to log messages
log_message() {
    local level="$1"
    shift
    local message="$*"
    echo "[$(date -Iseconds)] [$level] $message" >> "$FLUXION_LOG_FILE" 2>/dev/null || true
}

# Function to detect OS information
detect_os_info() {
    local os_info="Unknown"
    
    # Try /etc/os-release first (standard on modern systems)
    if [[ -f /etc/os-release ]]; then
        source /etc/os-release
        if [[ -n "${PRETTY_NAME:-}" ]]; then
            os_info="$PRETTY_NAME"
        elif [[ -n "${NAME:-}" ]] && [[ -n "${VERSION:-}" ]]; then
            os_info="$NAME $VERSION"
        elif [[ -n "${NAME:-}" ]]; then
            os_info="$NAME"
        fi
    # Fallback to lsb_release
    elif command -v lsb_release &> /dev/null; then
        os_info=$(lsb_release -d 2>/dev/null | cut -f2- || echo "Unknown")
    # Fallback to /etc/issue
    elif [[ -f /etc/issue ]]; then
        os_info=$(head -n1 /etc/issue | sed 's/\\n//g; s/\\l//g' | xargs)
    fi
    
    echo "$os_info"
}

# Local APT trust helpers
detect_security_keyring_trusts() {
    local publisher="$1"
    local source="$2"
    local release_line="$3"
    local -a keyrings=()

    case "$publisher" in
        o=Ubuntu)
            if [[ -v FLUXION_APT_UBUNTU_KEYRING ]]; then
                keyrings+=("${FLUXION_APT_UBUNTU_KEYRING}")
            elif [[ -v FLUXION_UBUNTU_KEYRING ]]; then
                keyrings+=("${FLUXION_UBUNTU_KEYRING}")
            else
                keyrings+=(/usr/share/keyrings/ubuntu-archive-keyring.gpg /usr/share/keyrings/ubuntu-archive-keyring.pgp)
            fi
            ;;
        o=Debian)
            if [[ -v FLUXION_APT_DEBIAN_KEYRING ]]; then
                keyrings+=("${FLUXION_APT_DEBIAN_KEYRING}")
            elif [[ -v FLUXION_DEBIAN_KEYRING ]]; then
                keyrings+=("${FLUXION_DEBIAN_KEYRING}")
            else
                keyrings+=(/usr/share/keyrings/debian-archive-keyring.gpg /usr/share/keyrings/debian-archive-keyring.pgp)
            fi
            ;;
        *) return 1 ;;
    esac

    local keyring
    for keyring in "${keyrings[@]}"; do
        [[ -n "$keyring" && -r "$keyring" && -s "$keyring" ]] || continue

        if grep -Iq . "$keyring" 2>/dev/null; then
            if [[ "$publisher" == "o=Ubuntu" ]] && grep -Fq "Debian archive signing key" "$keyring" 2>/dev/null; then continue; fi
            if [[ "$publisher" == "o=Debian" ]] && grep -Fq "Ubuntu archive signing key" "$keyring" 2>/dev/null; then continue; fi
        fi

        local signing_key=""
        if [[ "$release_line" =~ Signed-By[=:]([^[:space:],]+) ]]; then
            signing_key="${BASH_REMATCH[1]}"
        elif [[ "$release_line" =~ Key[=:]([^[:space:],]+) ]]; then
            signing_key="${BASH_REMATCH[1]}"
        elif [[ "$release_line" =~ Fingerprint[=:]([^[:space:],]+) ]]; then
            signing_key="${BASH_REMATCH[1]}"
        fi
        if [[ -n "$signing_key" ]] && ! grep -Fq -- "$signing_key" "$keyring" 2>/dev/null; then
            continue
        fi

        local uri="$source"
        uri="${uri#http://}"; uri="${uri#https://}"; uri="${uri%%[[:space:]]*}"
        local configured=false signed_by=""
        local signing_match=false
        local file_list=(/etc/apt/sources.list)
        [[ -n "${FLUXION_APT_SOURCES_LIST:-}" ]] && file_list=("$FLUXION_APT_SOURCES_LIST")
        [[ -d /etc/apt/sources.list.d ]] && file_list+=(/etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources)
        [[ -n "${FLUXION_APT_SOURCES_DIR:-}" && -d "$FLUXION_APT_SOURCES_DIR" ]] && file_list+=("$FLUXION_APT_SOURCES_DIR"/*.list "$FLUXION_APT_SOURCES_DIR"/*.sources)

        local source_file line
        for source_file in "${file_list[@]}"; do
            [[ -f "$source_file" ]] || continue
            while IFS= read -r line; do
                line="${line%%#*}"
                if [[ "$line" == *"$uri"* ]]; then
                    configured=true
                    if [[ "$line" =~ signed-by[=[:space:]] ]]; then
                        signed_by="${line##*signed-by=}"
                        signed_by="${signed_by%%]*}"
                        signed_by="${signed_by%%[[:space:]]*}"
                    elif [[ "${line,,}" =~ signed-by:[[:space:]]*([^[:space:]]+) ]]; then
                        signed_by="${BASH_REMATCH[1]}"
                    fi
                fi
            done < "$source_file"
        done

        if [[ "$configured" == true && -n "$signed_by" ]]; then
            if [[ "$signed_by" == "$keyring" ]]; then
                return 0
            elif [[ -f "$signed_by" && -f "$keyring" ]] && cmp -s "$signed_by" "$keyring"; then
                return 0
            elif [[ -n "${FLUXION_APT_SIGNING_KEY:-}" ]] && grep -Fq -- "${FLUXION_APT_SIGNING_KEY}" "$keyring" 2>/dev/null && [[ "$signed_by" == "${FLUXION_APT_SIGNING_KEY}" ]]; then
                return 0
            elif command -v gpg &>/dev/null && [[ "$signed_by" =~ ^[0-9A-Fa-f]+$ ]]; then
                if gpg --batch --with-colons --show-keys "$keyring" 2>/dev/null | grep -qi "^fpr:::::::::${signed_by}:$"; then
                    return 0
                fi
                continue
            else
                continue
            fi
        fi
        [[ "$configured" == true && -n "$signed_by" ]] && continue
        return 0
    done
    return 1
}

detect_security_source_is_insecure() {
    local description="$1"
    if [[ "$description" =~ trusted[[:space:]]*=[[:space:]]*(yes|true) ]] ||
       [[ "$description" =~ allow-insecure[[:space:]]*=[[:space:]]*(yes|true) ]]; then
        return 0
    fi

    local files=()
    [[ -n "${FLUXION_APT_SOURCES_LIST:-}" ]] && files+=("$FLUXION_APT_SOURCES_LIST")
    [[ -n "${FLUXION_APT_SOURCES_DIR:-}" ]] && files+=("$FLUXION_APT_SOURCES_DIR"/*.list "$FLUXION_APT_SOURCES_DIR"/*.sources)
    files+=(/etc/apt/sources.list)
    if [[ -d /etc/apt/sources.list.d ]]; then
        files+=(/etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources)
    fi

    local uri="$description"
    uri="${uri#http://}"; uri="${uri#https://}"
    uri="${uri%%[[:space:]]*}"
    local file line stanza=""
    for file in "${files[@]}"; do
        [[ -f "$file" ]] || continue
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            local lower_line="${line,,}"
            if [[ "$line" == *"$uri"* ]] && [[ "$line" =~ trusted[[:space:]]*=[[:space:]]*(yes|true) || "$line" =~ allow-insecure[[:space:]]*=[[:space:]]*(yes|true) ]]; then
                return 0
            fi
            if [[ "$lower_line" =~ ^[[:space:]]*(trusted|allow-insecure)[[:space:]]*:[[:space:]]*(yes|true)[[:space:]]*$ ]] && [[ "$stanza" == *"$uri"* ]]; then
                return 0
            fi
            if [[ -z "${line//[[:space:]]/}" ]]; then
                if [[ "$stanza" == *"$uri"* ]] && [[ "$stanza" =~ trusted[[:space:]_:]*[=:][[:space:]]*(yes|true) ]] ||
                   [[ "$stanza" == *"$uri"* ]] && [[ "$stanza" =~ allow-insecure[[:space:]_:]*[=:][[:space:]]*(yes|true) ]]; then
                    return 0
                fi
                stanza=""
                continue
            fi
            stanza+="$line "
        done < "$file"
        local lower_stanza="${stanza,,}"
        if [[ "$lower_stanza" == *"$uri"* ]] && [[ "$lower_stanza" =~ trusted[[:space:]_:]*[=:][[:space:]]*(yes|true) ]] ||
           [[ "$lower_stanza" == *"$uri"* ]] && [[ "$lower_stanza" =~ allow-insecure[[:space:]_:]*[=:][[:space:]]*(yes|true) ]]; then
            return 0
        fi
    done
    return 1
}

# Function to detect whether an exact package version came from an official security repository
detect_security_update() {
    local package_name="$1"
    local version="$2"

    [[ "${FLUXION_DETECT_SECURITY:-true}" == "true" ]] || { echo "false"; return; }
    command -v apt-cache &> /dev/null || { echo "false"; return; }

    local package_policy release_policy
    package_policy=$(apt-cache policy "$package_name" 2>/dev/null) || { echo "false"; return; }
    release_policy=$(apt-cache policy 2>/dev/null) || { echo "false"; return; }

    local -a exact_sources=()
    mapfile -t exact_sources < <(printf '%s\n' "$package_policy" | awk -v target="$version" '
        function trim(value) { sub(/^[[:space:]]+/, "", value); sub(/[[:space:]]+$/, "", value); return value }
        /^[[:space:]]*$/ { next }
        {
            rest=trim($0)
            if (rest ~ /^\*\*\*[[:space:]]+/) { sub(/^\*\*\*[[:space:]]+/, "", rest); split(rest, fields, /[[:space:]]+/); in_target=(fields[1]==target); next }
            split(rest, fields, /[[:space:]]+/)
            if (fields[2] ~ /^[0-9]+$/) { in_target=(fields[1]==target); next }
            if (fields[1] ~ /^[0-9]+$/ && in_target) { sub(/^[0-9]+[[:space:]]+/, "", rest); print trim(rest) }
        }
    ')
    ((${#exact_sources[@]} == 0)) && { echo "false"; return; }

    local description=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        local leading_trimmed="$line"
        leading_trimmed="${leading_trimmed#${leading_trimmed%%[![:space:]]*}}"
        if [[ "$leading_trimmed" =~ ^([0-9]+)[[:space:]]+(.+)$ ]]; then
            description="${BASH_REMATCH[2]}"
            description="${description%${description##*[![:space:]]}}"
            continue
        fi
        [[ "$leading_trimmed" =~ ^release[[:space:]]+(.+) ]] || continue

        local release_line="${BASH_REMATCH[1]}"
        local source_match=false source
        for source in "${exact_sources[@]}"; do
            if [[ "$description" == "$source" ]]; then source_match=true; break; fi
        done
        [[ "$source_match" == true ]] || continue
        detect_security_source_is_insecure "$description" && continue

        local publisher="" archive="" field suite=""
        IFS=',' read -r -a release_fields <<< "$release_line"
        for field in "${release_fields[@]}"; do
            field="${field#${field%%[![:space:]]*}}"
            field="${field%${field##*[![:space:]]}}"
            case "$field" in
                o=Ubuntu|o=Debian) publisher="$field" ;;
                a=*-security) archive="$field" ;;
            esac
        done

        local token
        for token in $description; do
            if [[ "$token" =~ ^([a-zA-Z0-9][a-zA-Z0-9.-]*)-security$ ]]; then
                suite="${BASH_REMATCH[1]}"
                break
            fi
        done
        [[ -n "$archive" && ( -z "$suite" || "$archive" == "a=$suite-security" ) ]] || continue
        if [[ -n "$publisher" && -n "$archive" ]] && detect_security_keyring_trusts "$publisher" "$description" "$release_line"; then
            echo "true"; return
        fi
    done <<< "$release_policy"

    echo "false"
}

# Function to send a single update to the API
send_single_update() {
    local hostname="$1"
    local os_info="$2"
    local package_name="$3"
    local old_version="$4"
    local new_version="$5"
    local is_security="$6"
    
    local json_payload
    json_payload=$(cat <<EOF
{
    "hostname": "$hostname",
    "os_info": "$os_info",
    "package_name": "$package_name",
    "old_version": $([[ "$old_version" == "-" ]] && echo "null" || echo "\"$old_version\""),
    "new_version": "$new_version",
    "is_security": $is_security
}
EOF
)
    
    local curl_args=(
        -X POST
        -H "Content-Type: application/json"
        --max-time "$FLUXION_TIMEOUT"
        --silent
        --show-error
        --fail
        -d "$json_payload"
    )
    
    if [[ -n "$FLUXION_API_KEY" ]]; then
        curl_args+=(-H "X-API-Key: $FLUXION_API_KEY")
    fi
    
    if curl "${curl_args[@]}" "${FLUXION_API_URL}/updates" &> /dev/null; then
        log_message "INFO" "Sent update: $package_name $old_version -> $new_version"
        return 0
    else
        log_message "ERROR" "Failed to send update: $package_name"
        return 1
    fi
}

# Function to send batch updates to the API
send_batch_updates() {
    local hostname="$1"
    local os_info="$2"
    shift 2
    local updates=("$@")
    
    # Build JSON array of updates
    local json_updates="["
    local first=true
    
    for update in "${updates[@]}"; do
        IFS='|' read -r package_name old_version new_version is_security <<< "$update"
        
        if [[ "$first" == true ]]; then
            first=false
        else
            json_updates+=","
        fi
        
        json_updates+=$(cat <<EOF
{
    "package_name": "$package_name",
    "old_version": $([[ "$old_version" == "-" ]] && echo "null" || echo "\"$old_version\""),
    "new_version": "$new_version",
    "is_security": $is_security
}
EOF
)
    done
    
    json_updates+="]"
    
    local json_payload
    json_payload=$(cat <<EOF
{
    "hostname": "$hostname",
    "os_info": "$os_info",
    "updates": $json_updates
}
EOF
)
    
    local curl_args=(
        -X POST
        -H "Content-Type: application/json"
        --max-time "$FLUXION_TIMEOUT"
        --silent
        --show-error
        --fail
        -d "$json_payload"
    )
    
    if [[ -n "$FLUXION_API_KEY" ]]; then
        curl_args+=(-H "X-API-Key: $FLUXION_API_KEY")
    fi
    
    if curl "${curl_args[@]}" "${FLUXION_API_URL}/updates/batch" &> /dev/null; then
        log_message "INFO" "Sent batch update with ${#updates[@]} packages"
        return 0
    else
        log_message "ERROR" "Failed to send batch update"
        return 1
    fi
}

# Main execution
main() {
    # Get hostname and OS info
    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)
    
    local os_info
    os_info=$(detect_os_info)
    
    # Read package information from stdin (APT provides this)
    # Format: <package> <old-version> <new-version>
    local updates=()
    
    while IFS=' ' read -r package_name old_version new_version rest; do
        # Skip empty lines and invalid entries
        [[ -z "$package_name" ]] && continue
        [[ -z "$new_version" ]] && continue
        
        # Handle new installations (old_version might be "- -")
        if [[ "$old_version" == "-" ]] || [[ "$old_version" == "**CONFIGURE**" ]]; then
            old_version="-"
        fi
        
        # Remove architecture suffix if present (e.g., :amd64)
        package_name="${package_name%:*}"

        # Detect if this package update likely comes from a security repository
        local is_security="false"
        is_security=$(detect_security_update "$package_name" "$new_version")
        
        if [[ "$FLUXION_BATCH_MODE" == "true" ]]; then
            # Collect updates for batch sending
            updates+=("${package_name}|${old_version}|${new_version}|${is_security}")
        else
            # Send each update individually
            send_single_update "$hostname" "$os_info" "$package_name" "$old_version" "$new_version" "$is_security" || true
        fi
    done
    
    # Send batch if we collected any updates
    if [[ "$FLUXION_BATCH_MODE" == "true" ]] && [[ ${#updates[@]} -gt 0 ]]; then
        send_batch_updates "$hostname" "$os_info" "${updates[@]}" || true
    fi
}

# APT Configuration
# This tells APT to pipe package information to this script
: <<'APT_CONFIG_SNIPPET'
DPkg::Post-Invoke {
    "if [ -x /etc/apt/apt.conf.d/99fluxion ]; then apt-cache policy | grep -E '^  Installed: [0-9]' -B 2 | /etc/apt/apt.conf.d/99fluxion || true; fi";
};
APT_CONFIG_SNIPPET

# Only run main if we're not being sourced (i.e., being executed directly)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
