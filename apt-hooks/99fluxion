#!/bin/bash
# Fluxion APT operation reporting hook
set -euo pipefail

FLUXION_API_URL="${FLUXION_API_URL:-}"
FLUXION_API_KEY="${FLUXION_API_KEY:-}"
FLUXION_TIMEOUT="${FLUXION_TIMEOUT:-5}"
FLUXION_LOG_FILE="${FLUXION_LOG_FILE:-/var/log/fluxion-hook.log}"
FLUXION_BATCH_MODE="${FLUXION_BATCH_MODE:-true}"
FLUXION_DETECT_SECURITY="${FLUXION_DETECT_SECURITY:-true}"
FLUXION_STATE_DIR="${FLUXION_STATE_DIR:-/var/lib/fluxion}"
FLUXION_STATE_FILE="${FLUXION_STATE_FILE:-$FLUXION_STATE_DIR/apt-operation.data}"

log_message() { local level="$1"; shift; echo "[$(date -Iseconds)] [$level] $*" >> "$FLUXION_LOG_FILE" 2>/dev/null || true; }
json_string() {
    local s=${1:-}; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '"%s"' "$s"
}
detect_os_info() {
    if [[ -r /etc/os-release ]]; then . /etc/os-release; printf '%s' "${PRETTY_NAME:-${NAME:-Unknown}}"; else printf 'Unknown'; fi
}

detect_security_update() {
    local package_name="$1" version="$2" policy_output
    [[ "$FLUXION_DETECT_SECURITY" == "true" ]] || { echo false; return; }
    command -v apt-cache >/dev/null 2>&1 || { echo false; return; }
    policy_output=$(apt-cache policy "$package_name" 2>/dev/null) || { echo false; return; }
    [[ -n "$policy_output" && -n "$version" && "$version" != "-" ]] || { echo false; return; }
    printf '%s\n' "$policy_output" | awk -v target="$version" '
      /^[[:space:]]*(\*\*\*[[:space:]]*)?[0-9A-Za-z:+.~_-]+[[:space:]]+[0-9]+[[:space:]]*$/ {
        line=$0; sub(/^[[:space:]]*/, "", line); sub(/^\*\*\*[[:space:]]*/, "", line)
        split(line, fields, /[[:space:]]+/); in_target=(fields[1] == target); next
      }
      in_target && /^[[:space:]]*release[[:space:]]/ {
        count=split($0, tokens, /[,[:space:]]+/)
        publisher=""; archive=""
        for (i=1; i<=count; i++) {
          if (tokens[i] ~ /^o=/) publisher=substr(tokens[i],3)
          if (tokens[i] ~ /^a=/) archive=substr(tokens[i],3)
        }
        if ((publisher=="Ubuntu" || publisher=="Debian") && archive ~ /-security$/) found=1
      }
      END { print found ? "true" : "false" }
    '
}

send_batch_updates() {
    local hostname="$1" os_info="$2"; shift 2
    local updates=("$@") json_updates="[" first=true update package_name old_version new_version is_security
    for update in "${updates[@]}"; do
        IFS='|' read -r package_name old_version new_version is_security <<< "$update"
        [[ "$first" == true ]] || json_updates+=,
        first=false
        json_updates+=$(cat <<EOF
{"package_name":$(json_string "$package_name"),"old_version":$([[ "$old_version" == "-" ]] && printf null || json_string "$old_version"),"new_version":$(json_string "$new_version"),"is_security":$is_security}
EOF
)
    done
    json_updates+=]
    local json_payload
    json_payload=$(cat <<EOF
{"hostname":$(json_string "$hostname"),"os_info":$(json_string "$os_info"),"updates":$json_updates}
EOF
)
    local curl_args=(-X POST -H 'Content-Type: application/json' --max-time "$FLUXION_TIMEOUT" --silent --show-error --fail -d "$json_payload")
    [[ -z "$FLUXION_API_KEY" ]] || curl_args+=(-H "X-API-Key: $FLUXION_API_KEY")
    curl "${curl_args[@]}" "${FLUXION_API_URL}/updates/batch" >/dev/null 2>&1 || log_message ERROR "Failed to send batch update"
}

stage_operation_data() {
    mkdir -p "$FLUXION_STATE_DIR" 2>/dev/null || return 0
    : > "$FLUXION_STATE_FILE" 2>/dev/null || return 0
    while read -r operation package_name old_version new_version architecture rest; do
        [[ "${operation:-}" == "VERSION" || "${operation:-}" == "version" ]] && continue
        [[ "${operation:-}" == upgrade || "${operation:-}" == install || "${operation:-}" == remove || "${operation:-}" == purge ]] || continue
        [[ -n "${package_name:-}" ]] || continue
        [[ "$operation" == remove || "$operation" == purge ]] && new_version="-"
        package_name="${package_name%:*}"
        if [[ "${old_version:-}" == "<none>" ]]; then old_version="-"; fi
        if [[ "${new_version:-}" == "<none>" ]]; then new_version="-"; fi
        [[ -n "${old_version:-}" && -n "${new_version:-}" ]] || continue
        printf '%s|%s|%s\n' "$package_name" "$old_version" "$new_version" >> "$FLUXION_STATE_FILE"
    done
}

report_staged_operation() {
    [[ -s "$FLUXION_STATE_FILE" ]] || return 0
    [[ -n "$FLUXION_API_URL" ]] || { rm -f "$FLUXION_STATE_FILE"; return 0; }
    local hostname os_info="$(detect_os_info)" package_name old_version new_version is_security updates=()
    hostname=$(hostname -f 2>/dev/null || hostname)
    while IFS='|' read -r package_name old_version new_version; do
        [[ -n "$package_name" ]] || continue
        is_security=false
        if [[ "$new_version" != "-" ]]; then
            is_security=$(detect_security_update "$package_name" "$new_version") || is_security=false
        fi
        updates+=("$package_name|$old_version|$new_version|$is_security")
    done < "$FLUXION_STATE_FILE"
    rm -f "$FLUXION_STATE_FILE"
    [[ ${#updates[@]} -eq 0 ]] || send_batch_updates "$hostname" "$os_info" "${updates[@]}" || true
}

main() {
    case "${1:-}" in
        --stage|--pre-install) stage_operation_data ;;
        --report|--post-invoke) report_staged_operation ;;
        *) report_staged_operation ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
