#!/bin/bash
#
# Fluxion APT Hook - Automatic Package Update Reporting
# 
# This script is executed by APT after package operations and reports
# package updates to the Fluxion API for centralized tracking.
#
# Installation:
#   sudo cp 99fluxion /etc/apt/apt.conf.d/99fluxion
#   sudo chmod +x /etc/apt/apt.conf.d/99fluxion
#
# Configuration via environment variables:
#   FLUXION_API_URL      - API endpoint (required)
#   FLUXION_API_KEY      - API authentication key (optional)
#   FLUXION_TIMEOUT      - HTTP request timeout in seconds (default: 5)
#   FLUXION_LOG_FILE     - Log file path (default: /var/log/fluxion-hook.log)
#   FLUXION_BATCH_MODE   - Send updates in batch (default: true)
#

set -euo pipefail

# Configuration with defaults
FLUXION_API_URL="${FLUXION_API_URL:-}"
FLUXION_API_KEY="${FLUXION_API_KEY:-}"
FLUXION_TIMEOUT="${FLUXION_TIMEOUT:-5}"
FLUXION_LOG_FILE="${FLUXION_LOG_FILE:-/var/log/fluxion-hook.log}"
FLUXION_BATCH_MODE="${FLUXION_BATCH_MODE:-true}"
FLUXION_DETECT_SECURITY="${FLUXION_DETECT_SECURITY:-true}"

# Exit early if API URL is not configured
if [[ -z "$FLUXION_API_URL" ]]; then
    exit 0
fi

# Function to log messages
log_message() {
    local level="$1"
    shift
    local message="$*"
    echo "[$(date -Iseconds)] [$level] $message" >> "$FLUXION_LOG_FILE" 2>/dev/null || true
}

# Function to detect OS information
detect_os_info() {
    local os_info="Unknown"
    
    # Try /etc/os-release first (standard on modern systems)
    if [[ -f /etc/os-release ]]; then
        source /etc/os-release
        if [[ -n "${PRETTY_NAME:-}" ]]; then
            os_info="$PRETTY_NAME"
        elif [[ -n "${NAME:-}" ]] && [[ -n "${VERSION:-}" ]]; then
            os_info="$NAME $VERSION"
        elif [[ -n "${NAME:-}" ]]; then
            os_info="$NAME"
        fi
    # Fallback to lsb_release
    elif command -v lsb_release &> /dev/null; then
        os_info=$(lsb_release -d 2>/dev/null | cut -f2- || echo "Unknown")
    # Fallback to /etc/issue
    elif [[ -f /etc/issue ]]; then
        os_info=$(head -n1 /etc/issue | sed 's/\\n//g; s/\\l//g' | xargs)
    fi
    
    echo "$os_info"
}

# Helpers beside security update detection
is_fluxion_insecure_source() {
    local description="$1"
    [[ "$description" =~ trusted[[:space:]]*=[[:space:]]*(yes|true) ]] && return 0
    [[ "$description" =~ allow-insecure[[:space:]]*=[[:space:]]*(yes|true) ]] && return 0
    return 1
}

verify_fluxion_inrelease() {
    local description="$1"
    local origin="$2"
    local suite="$3"
    local lists_dir="${FLUXION_APT_LISTS_DIR:-/var/lib/apt/lists}"
    local keyring=""

    case "$origin" in
        Ubuntu) keyring="${FLUXION_APT_UBUNTU_KEYRING:-/usr/share/keyrings/ubuntu-archive-keyring.gpg}" ;;
        Debian) keyring="${FLUXION_APT_DEBIAN_KEYRING:-/usr/share/keyrings/debian-archive-keyring.gpg}" ;;
        *) return 1 ;;
    esac
    command -v gpgv &>/dev/null || return 1

    local address
    address=$(awk '{print $1}' <<< "$description")
    address="${address#http://}"
    address="${address#https://}"
    address="${address%%[[:space:]]*}"
    [[ -n "$address" ]] || return 1

    local saved_address
    saved_address=$(printf '%s' "$address" | tr '/' '_')
    local release_file="$lists_dir/${saved_address}_dists_${suite}_InRelease"
    [[ -f "$release_file" ]] || return 1

    local verified
    if ! verified=$(gpgv --keyring "$keyring" --output - "$release_file" 2>/dev/null); then
        return 1
    fi

    local printed_origin="" printed_suite=""
    while IFS= read -r line; do
        if [[ "$line" =~ ^Origin:[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]]; then printed_origin="${BASH_REMATCH[1]}"; fi
        if [[ "$line" =~ ^Suite:[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]]; then printed_suite="${BASH_REMATCH[1]}"; fi
    done <<< "$verified"

    [[ "$printed_origin" == "$origin" && "$printed_suite" == "$suite" ]]
}

# Function to detect whether an exact package version came from an official security repository
detect_security_update() {
    local package_name="$1"
    local version="$2"

    [[ "${FLUXION_DETECT_SECURITY:-true}" == "true" ]] || { echo "false"; return; }
    command -v apt-cache &>/dev/null || { echo "false"; return; }

    local package_policy release_policy
    package_policy=$(apt-cache policy "$package_name" 2>/dev/null) || { echo "false"; return; }
    release_policy=$(apt-cache policy 2>/dev/null) || { echo "false"; return; }

    local -a exact_sources=()
    local in_target=false line rest
    while IFS= read -r line || [[ -n "$line" ]]; do
        rest="${line#${line%%[![:space:]]*}}"
        rest="${rest%${rest##*[![:space:]]}}"
        if [[ "$rest" =~ ^\*\*\*[[:space:]]+([^[:space:]]+)[[:space:]]+[0-9]+ ]]; then
            in_target=false
            [[ "${BASH_REMATCH[1]}" == "$version" ]] && in_target=true
            continue
        fi
        if [[ "$rest" =~ ^([^[:space:]]+)[[:space:]]+[0-9]+$ ]]; then
            in_target=false
            [[ "${BASH_REMATCH[1]}" == "$version" ]] && in_target=true
            continue
        fi
        if [[ "$in_target" == true && "$rest" =~ ^[0-9]+[[:space:]]+(.+)$ ]]; then
            exact_sources+=("${BASH_REMATCH[1]}")
        fi
    done <<< "$package_policy"
    ((${#exact_sources[@]} == 0)) && { echo "false"; return; }

    local description="" release_line=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        local leading="${line#${line%%[![:space:]]*}}"
        if [[ "$leading" =~ ^([0-9]+)[[:space:]]+(.+)$ ]]; then
            description="${BASH_REMATCH[2]}"
            description="${description%${description##*[![:space:]]}}"
            continue
        fi
        [[ "$leading" =~ ^release[[:space:]]+(.+) ]] || continue
        release_line="${BASH_REMATCH[1]}"

        local source_match=false source
        for source in "${exact_sources[@]}"; do
            if is_fluxion_insecure_source "$source"; then continue; fi
            if [[ "$description" == "$source" ]]; then source_match=true; break; fi
        done
        [[ "$source_match" == true ]] || continue
        is_fluxion_insecure_source "$description" && continue

        local origin="" suite="" archive="" field
        IFS=',' read -r -a release_fields <<< "$release_line"
        for field in "${release_fields[@]}"; do
            field="${field#${field%%[![:space:]]*}}"
            field="${field%${field##*[![:space:]]}}"
            case "$field" in
                o=Ubuntu) origin="Ubuntu" ;;
                o=Debian) origin="Debian" ;;
                a=*-security) archive="${field#a=}" ;;
            esac
        done
        [[ -n "$origin" && -n "$archive" ]] || continue

        local description_address description_suite
        read -r description_address description_suite _ <<< "$description"
        description_suite="${description_suite%%/*}"
        description_address="${description_address#http://}"
        description_address="${description_address#https://}"
        [[ "$description_suite" == "$archive" ]] || continue

        verify_fluxion_inrelease "$description" "$origin" "$archive" && { echo "true"; return; }
    done <<< "$release_policy"

    echo "false"
}

# Function to send a single update to the API
send_single_update() {
    local hostname="$1"
    local os_info="$2"
    local package_name="$3"
    local old_version="$4"
    local new_version="$5"
    local is_security="$6"
    
    local json_payload
    json_payload=$(cat <<EOF
{
    "hostname": "$hostname",
    "os_info": "$os_info",
    "package_name": "$package_name",
    "old_version": $([[ "$old_version" == "-" ]] && echo "null" || echo "\"$old_version\""),
    "new_version": "$new_version",
    "is_security": $is_security
}
EOF
)
    
    local curl_args=(
        -X POST
        -H "Content-Type: application/json"
        --max-time "$FLUXION_TIMEOUT"
        --silent
        --show-error
        --fail
        -d "$json_payload"
    )
    
    if [[ -n "$FLUXION_API_KEY" ]]; then
        curl_args+=(-H "X-API-Key: $FLUXION_API_KEY")
    fi
    
    if curl "${curl_args[@]}" "${FLUXION_API_URL}/updates" &> /dev/null; then
        log_message "INFO" "Sent update: $package_name $old_version -> $new_version"
        return 0
    else
        log_message "ERROR" "Failed to send update: $package_name"
        return 1
    fi
}

# Function to send batch updates to the API
send_batch_updates() {
    local hostname="$1"
    local os_info="$2"
    shift 2
    local updates=("$@")
    
    # Build JSON array of updates
    local json_updates="["
    local first=true
    
    for update in "${updates[@]}"; do
        IFS='|' read -r package_name old_version new_version is_security <<< "$update"
        
        if [[ "$first" == true ]]; then
            first=false
        else
            json_updates+=","
        fi
        
        json_updates+=$(cat <<EOF
{
    "package_name": "$package_name",
    "old_version": $([[ "$old_version" == "-" ]] && echo "null" || echo "\"$old_version\""),
    "new_version": "$new_version",
    "is_security": $is_security
}
EOF
)
    done
    
    json_updates+="]"
    
    local json_payload
    json_payload=$(cat <<EOF
{
    "hostname": "$hostname",
    "os_info": "$os_info",
    "updates": $json_updates
}
EOF
)
    
    local curl_args=(
        -X POST
        -H "Content-Type: application/json"
        --max-time "$FLUXION_TIMEOUT"
        --silent
        --show-error
        --fail
        -d "$json_payload"
    )
    
    if [[ -n "$FLUXION_API_KEY" ]]; then
        curl_args+=(-H "X-API-Key: $FLUXION_API_KEY")
    fi
    
    if curl "${curl_args[@]}" "${FLUXION_API_URL}/updates/batch" &> /dev/null; then
        log_message "INFO" "Sent batch update with ${#updates[@]} packages"
        return 0
    else
        log_message "ERROR" "Failed to send batch update"
        return 1
    fi
}

# Main execution
main() {
    # Get hostname and OS info
    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)
    
    local os_info
    os_info=$(detect_os_info)
    
    # Read package information from stdin (APT provides this)
    # Format: <package> <old-version> <new-version>
    local updates=()
    
    while IFS=' ' read -r package_name old_version new_version rest; do
        # Skip empty lines and invalid entries
        [[ -z "$package_name" ]] && continue
        [[ -z "$new_version" ]] && continue
        
        # Handle new installations (old_version might be "- -")
        if [[ "$old_version" == "-" ]] || [[ "$old_version" == "**CONFIGURE**" ]]; then
            old_version="-"
        fi
        
        # Remove architecture suffix if present (e.g., :amd64)
        package_name="${package_name%:*}"

        # Detect if this package update likely comes from a security repository
        local is_security="false"
        is_security=$(detect_security_update "$package_name" "$new_version")
        
        if [[ "$FLUXION_BATCH_MODE" == "true" ]]; then
            # Collect updates for batch sending
            updates+=("${package_name}|${old_version}|${new_version}|${is_security}")
        else
            # Send each update individually
            send_single_update "$hostname" "$os_info" "$package_name" "$old_version" "$new_version" "$is_security" || true
        fi
    done
    
    # Send batch if we collected any updates
    if [[ "$FLUXION_BATCH_MODE" == "true" ]] && [[ ${#updates[@]} -gt 0 ]]; then
        send_batch_updates "$hostname" "$os_info" "${updates[@]}" || true
    fi
}

# APT Configuration
# This tells APT to pipe package information to this script
: <<'APT_CONFIG_SNIPPET'
DPkg::Post-Invoke {
    "if [ -x /etc/apt/apt.conf.d/99fluxion ]; then apt-cache policy | grep -E '^  Installed: [0-9]' -B 2 | /etc/apt/apt.conf.d/99fluxion || true; fi";
};
APT_CONFIG_SNIPPET

# Only run main if we're not being sourced (i.e., being executed directly)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
