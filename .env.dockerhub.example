# Environment variables for docker-compose.dockerhub.yml
# Copy this file to .env and customize the values

# DockerHub Configuration
DOCKERHUB_USERNAME=wesback
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Database Configuration
POSTGRES_PASSWORD=fluxion_secure_password
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8000
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=info

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FLUXION_API_KEY=your-api-key-here
NODE_ENV=production

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_EXPORTER_TYPE=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=fluxion-backend
OTEL_ENVIRONMENT=production

# Jaeger Ports
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# CORS Configuration (MUST be JSON array format)
# For all origins (development only):
CORS_ORIGINS=["*"]
# For specific origins (production):
# CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
