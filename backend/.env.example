# Database Configuration
DATABASE_URL=postgresql+asyncpg://fluxion:fluxion@localhost:5432/fluxion

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# SQL Query Logging (set to true for debugging)
SQL_ECHO=false

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_EXPORTER_TYPE=console  # Options: console, otlp, otlp-http
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=fluxion
OTEL_ENVIRONMENT=development
