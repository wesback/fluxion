# Database Configuration
DATABASE_URL=postgresql+asyncpg://fluxion:fluxion@localhost:5432/fluxion

# Database Connection Pool Settings (required; startup rejects missing or invalid values)
API_REPLICAS=1
API_POOL_SIZE=4
API_MAX_OVERFLOW=4
RELAY_POOL_SIZE=4
RELAY_WORKER_COUNT=4
DB_POOL_TIMEOUT=5.0
DB_POOL_RECYCLE=3600
POSTGRES_MAX_CONNECTIONS=100
RESERVED_CONNECTIONS=20

# SQL Query Logging (set to true for debugging) 
SQL_ECHO=false

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# CORS Configuration (for frontend access)
# Use ["*"] for development only. In production, specify allowed origins:
# CORS_ORIGINS=["https://dashboard.example.com","https://admin.example.com"]
CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=info

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_EXPORTER_TYPE=console  # Options: console, otlp, otlp-http
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=fluxion
OTEL_ENVIRONMENT=development
