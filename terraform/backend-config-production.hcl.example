# Backend configuration for production environment
# Usage: terraform init -backend-config=backend-config-production.hcl

resource_group_name  = "fluxion-tfstate-rg"
storage_account_name = "fluxiontfstate"  # Replace with your actual storage account name
container_name       = "tfstate"
key                  = "fluxion-production.tfstate"
use_azuread_auth     = true
